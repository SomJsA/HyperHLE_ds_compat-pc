+pub const FUNCTIONS: FunctionExports = &[
+    export_c_func!(CGColorRetain(_)),
+    export_c_func!(CGColorRelease(_)),
+    export_c_func!(CGColorCreate(_, _)),
+    export_c_func!(CGColorCreateGenericRGB(_, _, _, _)),
