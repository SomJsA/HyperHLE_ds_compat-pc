+fn CGPathAddPath(
+    env: &mut Environment,
+    path: CGMutablePathRef,
+    _transform: MutVoidPtr,
+    other: CGPathRef,
+) {
+    if other.is_null() {
+        return;
+    }
+    let other_elems = env.objc.borrow::<CGPathHostObject>(other).elements.clone();
+    env.objc
+        .borrow_mut::<CGPathHostObject>(path)
+        .elements
+        .extend(other_elems);
+}
