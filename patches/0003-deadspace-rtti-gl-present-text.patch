-unsafe fn clamp_fog_state_values(gles: &mut dyn GLES) -> Option<(f32, f32)> {
-    let mut fog_enabled: GLboolean = 0;
-    gles.GetBooleanv(gles11::FOG, &mut fog_enabled);
-    if fog_enabled != 0 {
-        let mut fog_start: GLfloat = 0.0;
