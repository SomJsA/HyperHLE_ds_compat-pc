-            for (class_name, _) in dylib.class_exports.iter().copied().flatten() {
-                writeln!(file, "@interface {class_name}")?;
-                writeln!(file, "@end")?;
-                writeln!(file, "@implementation {class_name}")?;
-                writeln!(file, "@end")?;
