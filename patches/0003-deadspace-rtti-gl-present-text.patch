+pub fn CGContextStrokeRect(env: &mut Environment, context: CGContextRef, rect: CGRect) {
+    if context.is_null() {
+        return;
+    }
+    let lw = env.objc.borrow::<CGContextHostObject>(context).line_width;
+    CGContextStrokeRectWithWidth(env, context, rect, lw);
