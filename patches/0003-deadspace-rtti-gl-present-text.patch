+#[derive(Default)]
+pub struct State {
+    main_bundle: Option<id>,
+    // Keyed by bundle path String → NSBundle*
+    bundle_cache: HashMap<String, id>,
+    localization_tables: HashMap<id, id>, // NSString* → NSDictionary*
+}
