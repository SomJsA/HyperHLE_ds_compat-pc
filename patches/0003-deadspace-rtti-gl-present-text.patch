+pub fn CGDataProviderRelease(env: &mut Environment, c: CGDataProviderRef) {
+    if !c.is_null() {
+        CFRelease(env, c);
+    }
+}
+pub fn CGDataProviderRetain(env: &mut Environment, c: CGDataProviderRef) -> CGDataProviderRef {
+    if !c.is_null() {
+        CFRetain(env, c)
+    } else {
+        c
+    }
+}
