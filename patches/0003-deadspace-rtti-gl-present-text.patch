+    let host = env.objc.borrow_mut::<CGContextHostObject>(context);
+    host.shadow = CGShadowState {
+        enabled: true,
+        offset_x: offset.width,
+        offset_y: offset.height,
+        blur,
+        color: (0.0, 0.0, 0.0, 1.0 / 3.0),
