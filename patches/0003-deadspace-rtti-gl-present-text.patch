+// =========================================================================
+// MARK: - Retain / Release
+// =========================================================================
+
+pub fn CGFontRetain(env: &mut Environment, font: CGFontRef) -> CGFontRef {
+    if font.is_null() {
+        return Ptr::null();
+    }
+    CFRetain(env, font)
+}
+
+pub fn CGFontRelease(env: &mut Environment, font: CGFontRef) {
+    if font.is_null() {
+        return;
+    }
+    CFRelease(env, font);
+}
