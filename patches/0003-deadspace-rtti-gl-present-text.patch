-        const { std::cell::Cell::new(None) };
-    static PRESENT_SOURCE_RENDERBUFFER: std::cell::Cell<GLuint> =
-        const { std::cell::Cell::new(0) };
-    static PRESENT_TEXTURE_SIZE: std::cell::Cell<Option<(GLint, GLint)>> =
