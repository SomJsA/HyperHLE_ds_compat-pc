+        log_dbg!(
+            "NSURLConnection start: scheduling deferred failure \
+             (networking not supported in touchHLE)"
+        );
+        let sel = env.objc.register_host_selector("_touchHLE_deliverFailure".to_string(), &mut env.mem);
