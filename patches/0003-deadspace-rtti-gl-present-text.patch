+fn glClientWaitSync(
+    env: &mut Environment,
+    sync: GLuint,
+    flags: GLbitfield,
+    timeout_lo: GLuint,
+    timeout_hi: GLuint,
+) -> GLenum {
+    let timeout = ((timeout_hi as u64) << 32) | (timeout_lo as u64);
+    with_ctx_and_mem(env, |gles, _mem| unsafe {
+        gles.ClientWaitSync(sync as usize, flags, timeout)
+    })
+}
