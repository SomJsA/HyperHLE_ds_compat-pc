+
+- (())cancel {
+    log_dbg!("NSURLConnection cancel");
+    env.objc
+        .borrow_mut::<NSURLConnectionHostObject>(this)
+        .cancelled = true;
+}
+
+// MARK: - Dealloc
+
+- (())dealloc {
+    log_dbg!("NSURLConnection dealloc");
+    let delegate = env.objc
+        .borrow::<NSURLConnectionHostObject>(this)
+        .delegate;
