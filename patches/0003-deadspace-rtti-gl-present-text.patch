+/// Enforces the one (real) Environment limit. See
+/// [Environment::with_yielder] for why this is needed.
+static ENVIRONMENT_INSTANCE_EXISTS: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
