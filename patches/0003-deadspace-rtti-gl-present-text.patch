-    // "If the color parameter is NULL, then shadowing is disabled."
-    // https://developer.apple.com/documentation/coregraphics/1456225-cgcontextsetshadowwithcolor
-    if color.is_null() {
-        env.objc
-            .borrow_mut::<CGContextHostObject>(context)
-            .shadow
-            .enabled = false;
