+            let pixel_count: GuestUSize = width.checked_mul(height).unwrap().try_into().unwrap();
+            let size = image_size_estimate(pixel_count, format, type_);
+            mem.ptr_at(pixels.cast::<u8>(), size).cast::<GLvoid>()
+        };
