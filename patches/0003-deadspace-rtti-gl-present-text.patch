-        let mut buf = [0u8; 1024];
-        let mut len: GLsizei = 0;
-        gles.GetShaderInfoLog(fs, 1024, &mut len, buf.as_mut_ptr() as *mut _);
-        let s = std::str::from_utf8(std::slice::from_raw_parts(
