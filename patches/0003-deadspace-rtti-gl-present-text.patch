+impl Environment {
+    /// Loads the binary and sets up the emulator.
+    pub fn new(
+        bundle: bundle::Bundle,
+        fs: fs::Fs,
+        mut options: options::Options,
+        app_args: Vec<String>,
+    ) -> Result<Environment, String> {
+        let startup_time = Instant::now();
+        let launched_bundle_id = bundle.bundle_identifier().to_owned();
