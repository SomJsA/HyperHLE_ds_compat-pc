+fn alloc_path(env: &mut Environment, mutable: bool) -> CGPathRef {
+    let class = env.objc.get_known_class("_touchHLE_CGPath", &mut env.mem);
+    env.objc.alloc_object(
+        class,
+        Box::new(CGPathHostObject {
+            elements: Vec::new(),
+            mutable,
+        }),
+        &mut env.mem,
+    )
+}
