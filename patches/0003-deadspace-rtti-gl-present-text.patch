-        gles: &mut dyn GLES,
-        trace: bool,
-        seen: &std::sync::atomic::AtomicBool,
-        section: &'static str,
-    ) {
-        if !trace {
-            return;
-        }
-        let err = gles.GetError();
-        if err == 0 {
-            return;
-        }
-        if !seen.swap(true, std::sync::atomic::Ordering::Relaxed) {
-            log!(
-                "[--trace-gl-errors] present_renderbuffer: section {:?} produced GL error {:#x} [this log will only be shown once]",
-                section,
-                err
