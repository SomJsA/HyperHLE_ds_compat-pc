+                bl[1],
+                bl[2],
+                bl[3],
+                br[0],
+                br[1],
+                br[2],
+                br[3],
+                tl[0],
+                tl[1],
+                tl[2],
+                tl[3],
+                tr[0],
+                tr[1],
+                tr[2],
+                tr[3],
+                cc[0],
+                cc[1],
+                cc[2],
+                cc[3],
