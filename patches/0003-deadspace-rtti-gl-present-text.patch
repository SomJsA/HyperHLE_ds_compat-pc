+    let NSRange {
+        location: r_start,
+        length,
+    } = range;
+    let r_end: usize = r_start.checked_add(length).unwrap().try_into().unwrap();
+    let r_start: usize = r_start.try_into().unwrap();
+    let str_len = string.len();
+    assert!(r_end <= str_len, "Range out of bounds!");
