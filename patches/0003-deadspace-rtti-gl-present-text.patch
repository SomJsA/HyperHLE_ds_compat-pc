-    if !unwind_to_app_frame(env) {
-        log!(
-            "Warning: Could not unwind past C++ exception ({}); no app-level \
-             frame on the stack. Returning to caller; guest will likely abort.",
-            type_name
-        );
-    }
-}
-
-fn __cxa_rethrow(env: &mut Environment) {
