+impl std::fmt::Debug for Thread {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "Thread {{ active: {:?}, blocked_by: {:?}, return_value: {:?} }}",
+            self.active, self.blocked_by, self.return_value
+        )
+    }
+}
