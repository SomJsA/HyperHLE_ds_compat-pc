+- (id)principalClass {
+    let key: id = ns_string::get_static_str(env, "NSPrincipalClass");
+    let val: id = msg![env; this objectForInfoDictionaryKey:key];
+    if val == nil { return nil; }
+    msg![env; this classNamed:val]
+}
