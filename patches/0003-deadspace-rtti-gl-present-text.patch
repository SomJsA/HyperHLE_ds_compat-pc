+fn __dynamic_cast(
+    env: &mut Environment,
+    src: ConstVoidPtr,
+    src_type: ConstVoidPtr,
+    dst_type: ConstVoidPtr,
+    src2dst_offset: i32,
+) -> ConstVoidPtr {
+    let s = src.to_bits();
+    let src_ti = src_type.to_bits();
+    let dst_ti = dst_type.to_bits();
+    let verbose = {
+        use std::sync::atomic::{AtomicU32, Ordering};
+        static N: AtomicU32 = AtomicU32::new(0);
+        N.fetch_add(1, Ordering::Relaxed) < 30
+    };
+    if verbose {
+        let vt = *RTTI_VTABLE_ADDRS.lock().unwrap_or_else(|e| e.into_inner());
+        log!(
+            "[dyncast] src={:#x} src_ti={:#x}({}) dst_ti={:#x}({}) hint={} vt=[{:#x},{:#x},{:#x}]",
+            s,
+            src_ti,
+            rtti_typeinfo_name(env, src_ti),
+            dst_ti,
+            rtti_typeinfo_name(env, dst_ti),
+            src2dst_offset,
+            vt[0],
+            vt[1],
+            vt[2]
+        );
+    }
+    if s == 0 || src_ti == 0 || dst_ti == 0 {
+        return Ptr::null();
+    }
+    if src_ti == dst_ti {
+        return src;
+    }
+    // Dynamic type: the vptr's RTTI pointer lives just before the vtable.
+    let vptr = rtti_u32(env, s);
+    let dyn_ti = if vptr >= 8 { rtti_u32(env, vptr - 4) } else { 0 };
+    if verbose {
+        log!(
+            "[dyncast]  vptr={:#x} dyn_ti={:#x}({}) kind={:?}",
+            vptr,
+            dyn_ti,
+            rtti_typeinfo_name(env, dyn_ti),
+            rtti_kind(env, dyn_ti)
+        );
+    }
+    if dyn_ti == 0 {
+        return Ptr::null();
+    }
+    let off_src = rtti_offset(env, dyn_ti, src_ti, 0);
+    let off_dst = rtti_offset(env, dyn_ti, dst_ti, 0);
+    let result = match (off_src, off_dst) {
+        (Some(a), Some(b)) => Ptr::from_bits((s as i32).wrapping_add(b).wrapping_sub(a) as u32),
+        _ => Ptr::null(),
+    };
+    if verbose {
+        log!(
+            "[dyncast]  src_off={:?} dst_off={:?} => {:#x}",
+            off_src,
+            off_dst,
+            result.to_bits()
+        );
+    }
+    result
+}
