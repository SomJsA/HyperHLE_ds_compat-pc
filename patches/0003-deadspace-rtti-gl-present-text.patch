+fn parse_tuple(s: &str) -> Result<(f32, f32), ()> {
+    let (a, b) = s.split_once(", ").ok_or(())?;
+    Ok((a.parse().map_err(|_| ())?, b.parse().map_err(|_| ())?))
+}
