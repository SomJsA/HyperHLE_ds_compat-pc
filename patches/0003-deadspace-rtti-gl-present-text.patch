-    let type_name = if !tinfo.is_null() {
-        let name_field: ConstPtr<ConstPtr<u8>> = tinfo.cast();
-        let name_ptr: ConstPtr<u8> = env.mem.read(name_field + 1);
-        if !name_ptr.is_null() {
-            env.mem
-                .cstr_at_utf8(name_ptr)
-                .unwrap_or("(non-utf8)")
-                .to_owned()
