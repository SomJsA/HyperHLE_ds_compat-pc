+    if !unwind_to_app_frame(env) {
+        log!(
+            "Warning: _Unwind_SjLj_RaiseException with no recoverable frame; \
+             returning _URC_FATAL_PHASE1_ERROR to caller."
+        );
+        // _URC_FATAL_PHASE1_ERROR
+        return 3;
+    }
+    0
+}
