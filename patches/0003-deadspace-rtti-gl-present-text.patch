+fn CGContextAddRect(env: &mut Environment, context: CGContextRef, rect: CGRect) {
+    if context.is_null() {
+        return;
+    }
+    let o = rect.origin;
+    let s = rect.size;
+    let pts = [
+        CGPoint { x: o.x, y: o.y },
+        CGPoint {
+            x: o.x + s.width,
+            y: o.y,
+        },
+        CGPoint {
+            x: o.x + s.width,
+            y: o.y + s.height,
+        },
+        CGPoint {
+            x: o.x,
+            y: o.y + s.height,
+        },
+    ];
+    for p in pts {
+        env.objc
+            .borrow_mut::<CGContextHostObject>(context)
+            .path_points
+            .push(p);
+    }
