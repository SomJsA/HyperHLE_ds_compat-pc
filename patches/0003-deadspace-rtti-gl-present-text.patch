+/// Itanium ABI `__dynamic_cast`:
+///
+/// ```c
+/// void *__dynamic_cast(const void *src,
+///                      const __class_type_info *src_type,
+///                      const __class_type_info *dst_type,
+///                      ptrdiff_t src2dst_offset);
+/// ```
+///
+/// Returns the casted pointer on success, or NULL on failure (the cast
+/// does not apply / a `dynamic_cast<T*>` should evaluate to nullptr).
+///
+/// touchHLE has no real RTTI walk because every Itanium type_info vtable
+/// is stubbed (see [crate::dyld::do_non_lazy_linking]). We can't ever
+/// say "yes this is the right cast", so always returning NULL is the
+/// only safe answer — it matches the language semantics for failed
+/// casts. Apps that rely on dynamic_cast to *succeed* (rather than just
+/// using it as a defensive nullptr check) will still misbehave, but
+/// they were already going to crash on the broken vtables anyway.
+/// Base addresses of the stubbed Itanium RTTI vtables, published by
+/// [crate::dyld] when the corresponding symbols are linked.
+/// Index 0 = `__class_type_info`, 1 = `__si_class_type_info`,
+/// 2 = `__vmi_class_type_info`.
+pub static RTTI_VTABLE_ADDRS: Mutex<[u32; 3]> = Mutex::new([0; 3]);
+
+fn rtti_u32(env: &mut Environment, addr: u32) -> u32 {
+    env.mem.read(ConstPtr::<u32>::from_bits(addr))
+}
+
+fn rtti_typeinfo_name(env: &mut Environment, ti: u32) -> String {
+    if ti == 0 {
+        return "<null>".to_string();
+    }
+    let namep = rtti_u32(env, ti.wrapping_add(4));
+    if namep == 0 {
+        return "<noname>".to_string();
+    }
+    let mut s = String::new();
+    let mut a = namep;
+    while s.len() < 200 {
+        let b: u8 = env.mem.read(ConstPtr::<u8>::from_bits(a));
+        if b == 0 {
+            break;
+        }
+        s.push(b as char);
+        a = a.wrapping_add(1);
+    }
+    s
+}
+
+#[derive(Debug)]
+enum RttiKind {
+    Class,
+    Si(u32),
+    Vmi(Vec<(u32, i32)>),
+    Unknown,
+}
+
+/// Classify a `std::type_info` by comparing its vptr against the stubbed
+/// RTTI vtables that [crate::dyld] created.
+fn rtti_kind(env: &mut Environment, ti: u32) -> RttiKind {
+    let vt = match RTTI_VTABLE_ADDRS.lock() {
+        Ok(v) => *v,
+        Err(_) => return RttiKind::Unknown,
+    };
+    let vptr = rtti_u32(env, ti);
+    let is = |base: u32| base != 0 && (vptr == base || vptr == base.wrapping_add(8));
+    if is(vt[0]) {
+        return RttiKind::Class;
+    }
+    if is(vt[1]) {
+        return RttiKind::Si(rtti_u32(env, ti.wrapping_add(8)));
+    }
+    if is(vt[2]) {
+        let _flags = rtti_u32(env, ti.wrapping_add(8));
+        let n = rtti_u32(env, ti.wrapping_add(12));
+        let mut bases = Vec::new();
+        if n <= 64 {
+            for i in 0..n {
+                let b = ti.wrapping_add(16).wrapping_add(i * 8);
+                bases.push((rtti_u32(env, b), rtti_u32(env, b.wrapping_add(4)) as i32));
+            }
+        }
+        return RttiKind::Vmi(bases);
+    }
+    RttiKind::Unknown
+}
+
+/// Offset of `target` inside the complete object described by `ti`, following
+/// public non-virtual base paths. `None` if `target` is not a public base.
+fn rtti_offset(env: &mut Environment, ti: u32, target: u32, depth: u32) -> Option<i32> {
+    if depth > 16 || ti == 0 {
+        return None;
+    }
+    if ti == target {
+        return Some(0);
+    }
+    match rtti_kind(env, ti) {
+        RttiKind::Class | RttiKind::Unknown => None,
+        RttiKind::Si(base) => rtti_offset(env, base, target, depth + 1),
+        RttiKind::Vmi(bases) => {
+            const VIRTUAL: i32 = 0x1;
+            const PUBLIC: i32 = 0x2;
+            for (bti, of) in bases {
+                if (of & PUBLIC) == 0 || (of & VIRTUAL) != 0 {
+                    continue;
+                }
+                let off = of >> 8;
+                if let Some(sub) = rtti_offset(env, bti, target, depth + 1) {
+                    return Some(off.wrapping_add(sub));
+                }
+            }
+            None
+        }
+    }
+}
