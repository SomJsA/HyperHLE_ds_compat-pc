+    path: "/System/Library/Frameworks/OpenGLES.framework/OpenGLES",
+    aliases: &[],
+    class_exports: &[eagl::CLASSES],
+    constant_exports: &[eagl::CONSTANTS],
+    function_exports: &[gles_guest::FUNCTIONS, eagl::FUNCTIONS],
+};
